# syntax=docker/dockerfile:1

FROM python:3.12-slim AS dependencies

ARG REQUIREMENTS_FILE=python/requirements-linux-x86_64-cpu.txt
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv

RUN python -m venv "$VIRTUAL_ENV"
COPY ${REQUIREMENTS_FILE} /tmp/requirements.txt
RUN "$VIRTUAL_ENV/bin/python" -m pip install --require-hashes -r /tmp/requirements.txt

FROM python:3.12-slim AS runtime

ARG APP_UID=10001
ARG APP_GID=10001
ENV FLY_BACKEND=cpu \
    FLY_DATA_ROOT=/data \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/python \
    PYTHONUNBUFFERED=1

RUN groupadd --gid "$APP_GID" fly \
    && useradd --uid "$APP_UID" --gid "$APP_GID" --create-home --home-dir /home/fly fly \
    && install -d -o "$APP_UID" -g "$APP_GID" /app /data

COPY --from=dependencies /opt/venv /opt/venv
COPY --chown=10001:10001 python/fly_crossy /app/python/fly_crossy

USER 10001:10001
WORKDIR /app
EXPOSE 8000

CMD ["uvicorn", "fly_crossy.server:app", "--host", "0.0.0.0", "--port", "8000"]
