# JavaScript and build output
node_modules/
dist/
data/visitor-ranking.sqlite*
coverage/
*.tsbuildinfo

# Python caches, environments, and generated runs
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
python/.pytest_tmp*/
.ruff_cache/
*.egg-info/
.venv/
python/runs/

# Local configuration and generated project output
.env*
!.env.example
outputs/
.worktrees/
.superpowers/
.local/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db

# Generated neural artifacts and datasets
artifacts/
python/datasets/

# Training outputs stay local. Commit curated summaries under docs/experiments/.
/runs/*
!/runs/README.md
# Historical audits in reports/ remain tracked; new reports are local by default.
/reports/
*.pt
*.pth
*.ckpt
*.safetensors
# Released, reviewed artifacts are intentionally distributable.
!release/**/*.pt
!release/**/*.pth
!release/**/*.ckpt
!release/**/*.safetensors
