# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM nginx:1.28-alpine AS runtime

ARG APP_UID=10001
ARG APP_GID=10001
ENV SIMULATION_UPSTREAM=simulation:8000

RUN addgroup -S -g "$APP_GID" fly \
    && adduser -S -D -H -u "$APP_UID" -G fly fly \
    && sed -i \
        -e '/^user /d' \
        -e 's!pid        /run/nginx.pid;!pid        /tmp/nginx.pid;!' \
        /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/cache/nginx /var/run /etc/nginx/conf.d \
    && chown -R "$APP_UID:$APP_GID" /var/cache/nginx /var/run /etc/nginx/conf.d

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template

USER 10001:10001
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
